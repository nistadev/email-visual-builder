{
  "name": "email-visual-builder",
  "version": "0.1.0",
  "description": "A visual email builder for React: a versioned document model, a drag-and-drop editor, and deterministic email-safe HTML export. Also renders landing pages.",
  "license": "Apache-2.0",
  "author": "Patriciu Nista",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nistadev/email-visual-builder.git"
  },
  "homepage": "https://github.com/nistadev/email-visual-builder#readme",
  "bugs": {
    "url": "https://github.com/nistadev/email-visual-builder/issues"
  },
  "keywords": [
    "email",
    "email-builder",
    "email-editor",
    "visual-builder",
    "drag-and-drop",
    "react",
    "lexical",
    "html-email",
    "newsletter",
    "landing-page"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./renderers": {
      "types": "./dist/renderers/index.d.ts",
      "default": "./dist/renderers/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./styles.css": "./dist/react/styles.css",
    "./standalone.css": "./dist/react/standalone.css"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && node scripts/build-standalone-css.mjs",
    "dev": "tsc --watch -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.{ts,tsx}\"",
    "test:bench": "tsx --test \"src/**/*.bench.{ts,tsx}\"",
    "clean": "rimraf dist",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "prepublishOnly": "pnpm clean && pnpm build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.md\"",
    "sandbox": "vite sandbox --port 6011"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lexical/history": "0.48.0",
    "@lexical/html": "0.48.0",
    "@lexical/link": "0.48.0",
    "@lexical/list": "0.48.0",
    "@lexical/react": "0.48.0",
    "@lexical/rich-text": "0.48.0",
    "@lexical/selection": "0.48.0",
    "@lexical/utils": "0.48.0",
    "lexical": "0.48.0",
    "lucide-react": "1.25.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/addon-docs": "9.1.20",
    "@storybook/react-vite": "9.1.20",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "daisyui": "5.6.7",
    "jsdom": "29.1.1",
    "postcss": "8.5.16",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rimraf": "5.0.10",
    "storybook": "9.1.20",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vite": "5.4.21",
    "prettier": "3.9.4"
  },
  "packageManager": "pnpm@11.9.0"
}
